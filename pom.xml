<?xml version="1.0" encoding="UTF-8"?>
<!--
    detalkipro-partners — парсер карточек товаров проверенных партнёров
    маркетплейса «ДеталькиПро» с выгрузкой CSV для WebAsyst Shop-Script.
    Создатель и автор: Падерин Павел Владимирович
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>pro.detalki</groupId>
    <artifactId>detalkipro-partners</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>detalkipro-partners</name>
    <description>Парсер карточек товаров проверенных партнёров «ДеталькиПро». Создатель: Падерин Павел Владимирович</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>pro.detalki.partners.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
